# Copy this file to .env.local and fill in real values. Never commit the real file.
# Wrap any value that contains # or $ in single quotes, e.g. ADMIN_PASSWORD='pa#ss'

# ---- Database ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/zoxen_crm
MONGODB_DB=zoxen_crm

# ---- First super admin login ----
# Used once to create the first Super Admin account, then keeps working as a recovery login.
# Add the rest of the team and clients from "Team & Portal Users" inside the app.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD='change-this-password'
# Long random string (32+ characters) used to sign login sessions
AUTH_SECRET=replace-with-a-long-random-secret-string

# ---- Public URL (used for invoice share links) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Onboarding form integration ----
ONBOARDING_API_KEY=replace-with-a-random-key
ONBOARDING_ALLOWED_ORIGIN=*

# ---- Email (Gmail App Password) ----
# Google Account > Security > 2-Step Verification ON > App passwords > create one for "Mail".
# Leave SMTP_USER/SMTP_PASS empty to skip email (invite links are then shown for you to copy).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS='abcd efgh ijkl mnop'
MAIL_FROM_NAME=Zoxen Digital

# ---- Phone / desktop push notifications (free) ----
# Generate once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:yourname@gmail.com

# ---- Google Calendar / Meet (optional) ----
# Google Cloud > APIs & Services: enable Calendar API, create an OAuth "Web application" client with redirect URI
# https://<your-domain>/api/google/callback  — then click "Connect Google Calendar" in Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- File uploads (Vercel Blob) ----
# Created with: vercel blob create-store <name> --access public  (adds this automatically on Vercel)
BLOB_READ_WRITE_TOKEN=

# ---- Daily job (recurring invoices, reminders, morning digest) ----
# Any long random string. Vercel Cron sends it automatically (schedule in vercel.json).
CRON_SECRET=
